---
import { sized } from "../../lib/img";
import { tf } from "../../lib/tina";
import { toneClass } from "../../lib/tone";
const { heading, body, items = [], tone } = Astro.props;
---
<section class:list={["section logos", toneClass(tone)]} data-tina-field={tf(Astro.props)}>
  <div class="wrap">
    {heading && <h2 data-tina-field={tf(Astro.props, "heading")}>{heading}</h2>}
    {body && <p class="lede" data-tina-field={tf(Astro.props, "body")}>{body}</p>}
    <ul class="row">
      {items?.map((l: any) => {
        const inner = (
          <>
            {l.image && <img src={sized(l.image, 400)} alt="" loading="lazy" data-tina-field={tf(l, "image")} />}
            <span class="nm" data-tina-field={tf(l, "name")}>{l.name}</span>
          </>
        );
        return <li data-tina-field={tf(l)}>{l.href ? <a href={l.href} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
      })}
    </ul>
  </div>
</section>
<style>
  .logos { padding-block: var(--section); }
  .row { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); }
  .row li > * { display: grid; gap: 10px; justify-items: center; align-content: center; height: 100%; padding: 18px 14px 14px; background: var(--white); color: var(--black); border: 2px solid var(--black); text-decoration: none; text-align: center; }
  .row img { height: 64px; width: 100%; object-fit: contain; }
  .nm { font-size: 0.85rem; font-weight: 500; line-height: 1.3; }
  .row a:hover { box-shadow: var(--shadow) var(--shadow) 0 var(--shadow-c); }
</style>
